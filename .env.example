# Plantilla: copia a .env.local (ignorado por Git) y rellena valores SOLO en tu entorno.
# Nunca pongas secretos reales en este archivo ni versiones un .env con valores.

# --- Servidor web (rol de aplicación, sujeto a RLS; NO debe ser propietario ni superusuario)
# DATABASE_URL=postgres://nebora_app:<contraseña>@127.0.0.1:5432/nebora_dev

# Registro público de cuentas. Desactivado por defecto ("false").
# AUTH_ALLOW_SIGNUP=false

# Origen público de la aplicación (sin ruta). Necesario para generar códigos QR;
# sin él, los QR aparecen como no configurados. En producción debe ser https.
# APP_BASE_URL=http://localhost:3000

# --- Migraciones y herramientas locales (rol propietario del esquema, sin superusuario)
# Lo usan `pnpm db:migrate`, `pnpm db:setup-local`, las pruebas de integración y E2E.
# Nunca debe estar disponible para el proceso web.
# DATABASE_ADMIN_URL=postgres://nebora_admin:<contraseña>@127.0.0.1:5432/nebora_dev

# Contraseña que `db:setup-local` y las pruebas asignan al rol nebora_app (solo dev/test).
# NEBORA_APP_DB_PASSWORD=

# --- Pruebas E2E (opcional): ruta a un Chromium ya instalado
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# --- Pendiente de integrar (no configurado; las funciones dependientes permanecen desactivadas)
# EMAIL_PROVIDER_API_KEY=
# STORAGE_BUCKET=
